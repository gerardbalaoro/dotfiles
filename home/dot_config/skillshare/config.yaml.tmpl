# yaml-language-server: $schema=https://raw.githubusercontent.com/runkids/skillshare/main/schemas/config.schema.json
sources:
  skills: {{ joinPath .chezmoi.homeDir ".config/skillshare/skills" | quote }}
  agents: {{ joinPath .chezmoi.homeDir ".config/skillshare/agents" | quote }}
mode: merge
targets:
  universal:
    skills:
      path: {{ joinPath .chezmoi.homeDir ".agents/skills" | quote }}
ignore:
  - .DS_Store
  - .git/
  - __pycache__/
audit:
  block_threshold: CRITICAL
