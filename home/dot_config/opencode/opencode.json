{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "chat",
  "agent": {
    "chat": {
      "mode": "primary",
      "description": "A fast, general-purpose agent.",
      "model": "openai/gpt-5.6-luna"
    },
    "build": {
      "disable": true
    }
  },
  "lsp": true,
  "permission": {
    "external_directory": {
      "*": "allow"
    }
  },
  "plugin": ["opencode-pty"]
}
